<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice notes. Screenshots and notes are written via MediaStore, which needs no storage permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- RecordingService keeps the mic usable while recording (see audio/RecordingService.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Reminders on screenshots (Android 13+ asks at the moment you set one). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ThinkingSpaceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ThinkingSpace">

        <!--
            Settings screen. It also declares ACTION_ASSIST, which the Android
            ASSISTANT role requires, and doubles as the voice-interaction
            settings page (see res/xml/interaction_service.xml).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- App home. Settings live behind the gear in its top right corner (MainActivity). -->
        <activity
            android:name=".GalleryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <activity android:name=".ViewerActivity" android:exported="false" />

        <!-- Voice memo with no screenshot: launcher shortcut and Quick Settings tile open this. -->
        <activity
            android:name=".MemoActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/shortcut_memo_short" />

        <!-- "Share to Thinking Space": saves shared text, links, images and audio, then closes. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ThinkingSpace.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaptureTile"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/tile_memo"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver android:name=".reminder.Reminders$ReminderReceiver" android:exported="false" />

        <!-- The service the system binds to once this app is the default assistant. -->
        <service
            android:name=".AssistInteractionService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <!-- Creates one session (the assistant UI) per invocation. -->
        <service
            android:name=".AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name=".audio.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Required by the voice-interaction metadata on some Android versions. -->
        <service
            android:name=".StubRecognitionService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>

</manifest>
